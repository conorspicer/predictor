# Set these in your host's environment; Django does not load .env automatically.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,nflpredictor.pythonanywhere.com
DATABASE_ENGINE=mysql
DATABASE_NAME=nflpredictor$predictorDB
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=3306
# Optional ISO 8601 end of week 1 (Wednesday 05:00 UTC); otherwise use active fixtures.
SEASON_WEEK_ONE_END=
